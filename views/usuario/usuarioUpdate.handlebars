<h2>Editar usuário</h2>
<form action="/usuarioUpdate" method="post">
    <input type="hidden" name="id" value="{{usuario.id}}">
    <div class="form-group">
        <label for="nome">Nome</label>
        <input type="text" class="form-control" id="nome" name="nome" value="{{usuario.nome}}" required>
    </div>
    <div class="form-group">
        <label for="login">Login</label>
        <input type="text" class="form-control" id="login" name="login" value="{{usuario.login}}" required>
    </div>
    <div class="form-group">
        <label for="senha">Nova senha</label>
        <input type="password" class="form-control" id="senha" name="senha" placeholder="Deixe em branco para manter a atual">
    </div>
    <div class="form-group">
        <label for="tipo">Perfil</label>
        <select class="form-control" id="tipo" name="tipo">
            {{#each perfis}}
            <option value="{{valor}}" {{#if (eq valor ../usuario.tipo)}}selected{{/if}}>{{nome}}</option>
            {{/each}}
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
</form>
