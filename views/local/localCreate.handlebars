<h2>Cadastrar local</h2>
<form action="/localCreate" method="post">
    <div class="form-group">
        <label for="nome">Nome</label>
        <input type="text" class="form-control" id="nome" name="nome" placeholder="Ex.: Auditório B" required>
    </div>
    <div class="form-group">
        <label for="capacidade">Capacidade (pessoas)</label>
        <input type="number" class="form-control" id="capacidade" name="capacidade" min="1" required>
    </div>
    <button type="submit" class="btn btn-primary">Cadastrar</button>
</form>
