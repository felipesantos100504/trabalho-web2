<h2>Editar local</h2>
<form action="/localUpdate" method="post">
    <input type="hidden" name="id" value="{{local.id}}">
    <div class="form-group">
        <label for="nome">Nome</label>
        <input type="text" class="form-control" id="nome" name="nome" value="{{local.nome}}" required>
    </div>
    <div class="form-group">
        <label for="capacidade">Capacidade (pessoas)</label>
        <input type="number" class="form-control" id="capacidade" name="capacidade" min="1" value="{{local.capacidade}}" required>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
</form>
